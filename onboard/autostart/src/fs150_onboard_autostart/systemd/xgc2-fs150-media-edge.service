[Unit]
Description=XGC2 FS150 Media Edge (WebRTC and camera)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=marvsmart
Group=marvsmart
SupplementaryGroups=video
RuntimeDirectory=xgc2/media-edge
RuntimeDirectoryMode=0700
EnvironmentFile=-/etc/xgc2/fs150/onboard.env
ExecStart=/usr/lib/xgc2/fs150/autostart/start-media-edge
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
