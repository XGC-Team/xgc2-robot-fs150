#!/usr/bin/env bash
set -euo pipefail

# Native V4L2 -> one H264 encode -> Media Edge. No ROS re-encode.
DEVICE="${CAMERA_DEVICE:-/dev/video8}"
WIDTH="${CAMERA_WIDTH:-640}"
HEIGHT="${CAMERA_HEIGHT:-480}"
FPS="${CAMERA_FPS:-30}"
PIXEL="${CAMERA_PIXEL_FORMAT:-nv12}"
ENCODER="${CAMERA_ENCODER:-x264}"
SOURCE_ID="${CAMERA_SOURCE_ID:-fs150_cam}"
RTP_PORT="${CAMERA_RTP_PORT:-5004}"
SOCK="${CAMERA_CONTROL_SOCKET:-/tmp/xgc2/media/fs150_cam.sock}"

if [[ ! -e "${DEVICE}" ]]; then
  echo "fs150 camera: device missing ${DEVICE} (need rkaiq_3A / rkisp_mainpath)" >&2
  exit 1
fi

NATIVE=""
for c in \
  "$(command -v xgc_native_v4l2_rtp || true)" \
  "/opt/ros/${ROS_DISTRO:-noetic}/lib/xgc2_camera_driver/xgc_native_v4l2_rtp"
do
  if [[ -n "${c}" && -x "${c}" ]]; then
    NATIVE="${c}"
    break
  fi
done
if [[ -z "${NATIVE}" ]]; then
  echo "fs150 camera: xgc_native_v4l2_rtp missing; install ros-noetic-xgc2-camera-driver" >&2
  exit 1
fi

mkdir -p "$(dirname "${SOCK}")"
echo "xgc2 fs150 camera: native ${DEVICE} encoder=${ENCODER} -> :${RTP_PORT}"
exec "${NATIVE}" \
  --device "${DEVICE}" \
  --width "${WIDTH}" \
  --height "${HEIGHT}" \
  --fps "${FPS}" \
  --pixel-format "${PIXEL}" \
  --encoder "${ENCODER}" \
  --source-id "${SOURCE_ID}" \
  --frame-id "${CAMERA_FRAME_ID:-fs150_cam_optical_frame}" \
  --rtp-port "${RTP_PORT}" \
  --control-socket "${SOCK}"
