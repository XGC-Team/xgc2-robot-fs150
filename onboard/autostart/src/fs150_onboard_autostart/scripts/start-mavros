#!/usr/bin/env bash
set -euo pipefail

ROS_DISTRO="${ROS_DISTRO:-noetic}"
ROS_PREFIX="/opt/ros/${ROS_DISTRO}"
if [[ -f "${ROS_PREFIX}/setup.bash" ]]; then
  # shellcheck disable=SC1090
  set +u
  source "${ROS_PREFIX}/setup.bash"
  set -u
fi

export ROS_MASTER_URI="${ROS_MASTER_URI:-http://127.0.0.1:11311}"
export ROS_IP="${ROS_IP:-127.0.0.1}"

HERE="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
FCU_URL="${FCU_URL:-udp://:14551@127.0.0.1:14561}"
# The address provides the expected identity; the flight controller is authoritative.
mapfile -t fleet_ids < <(ip -4 -o addr show scope global | awk '{split($4,a,"/"); split(a[1],b,"."); if (b[1]==192 && b[2]==168 && b[3]==51 && b[4]>=11 && b[4]<=30) print b[4]-10}' | sort -u)
identity_args=()
if [[ ${#fleet_ids[@]} == 1 ]]; then
  identity_args=(--expected "${fleet_ids[0]}")
elif [[ -n "${MAV_SYS_ID:-}" ]]; then
  identity_args=(--expected "$MAV_SYS_ID")
fi
TGT_SYSTEM="$(python3 "${HERE}/read-fcu-identity" "${identity_args[@]}")"
TGT_COMPONENT="${MAV_COMP_ID:-1}"

echo "xgc2 fs150 mavros: ${FCU_URL} sys=${TGT_SYSTEM} via official mavros/px4.launch"
exec roslaunch mavros px4.launch \
  gcs_url:="" \
  fcu_url:="${FCU_URL}" \
  tgt_system:="${TGT_SYSTEM}" \
  tgt_component:="${TGT_COMPONENT}"
