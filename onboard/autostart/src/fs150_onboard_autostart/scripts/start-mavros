#!/usr/bin/env bash
set -euo pipefail

ROS_DISTRO="${ROS_DISTRO:-noetic}"
ROS_PREFIX="/opt/ros/${ROS_DISTRO}"
if [[ -f "${ROS_PREFIX}/setup.bash" ]]; then
  # shellcheck disable=SC1090
  set +u
  source "${ROS_PREFIX}/setup.bash"
  set -u
fi

export ROS_MASTER_URI="${ROS_MASTER_URI:-http://127.0.0.1:11311}"
export ROS_IP="${ROS_IP:-127.0.0.1}"

LAUNCH="${MAVROS_LAUNCH:-/usr/share/xgc2/fs150/mavros/launch/mavros.launch}"
[[ -f "$LAUNCH" ]] || { echo "fs150 mavros: launch file missing: $LAUNCH" >&2; exit 1; }


FCU_URL="${FCU_URL:-udp://:14551@127.0.0.1:14561}"
TGT_SYSTEM="${MAV_SYS_ID:?Set this aircraft MAV_SYS_ID in /etc/xgc2/fs150/onboard.env}"
[[ "$TGT_SYSTEM" =~ ^[0-9]+$ ]] && ((10#$TGT_SYSTEM >= 1 && 10#$TGT_SYSTEM <= 255)) || {
  echo 'MAV_SYS_ID must be an integer from 1 to 255' >&2; exit 1;
}
TGT_COMPONENT="${MAV_COMP_ID:-1}"

echo "xgc2 fs150 mavros: ${FCU_URL} sys=${TGT_SYSTEM} via ${LAUNCH}"
exec roslaunch "${LAUNCH}" \
  fcu_url:="${FCU_URL}" \
  tgt_system:="${TGT_SYSTEM}" \
  tgt_component:="${TGT_COMPONENT}"
