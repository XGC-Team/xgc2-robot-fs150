#!/usr/bin/env bash
set -euo pipefail

ROS_DISTRO="${ROS_DISTRO:-noetic}"
ROS_PREFIX="/opt/ros/${ROS_DISTRO}"
if [[ -f "${ROS_PREFIX}/setup.bash" ]]; then
  # shellcheck disable=SC1090
  set +u
  source "${ROS_PREFIX}/setup.bash"
  set -u
fi

export ROS_MASTER_URI="${ROS_MASTER_URI:-http://127.0.0.1:11311}"
export ROS_IP="${ROS_IP:-127.0.0.1}"

LAUNCH="${MOCAP_LAUNCH:-/usr/share/xgc2/fs150/mocap/launch/mocap.launch}"
[[ -f "$LAUNCH" ]] || { echo "fs150 mocap: launch file missing: $LAUNCH" >&2; exit 1; }

if ! rospack find xgc2_vrpn_relay >/dev/null 2>&1; then
  echo "fs150 mocap: ROS package xgc2_vrpn_relay not found (apt install ros-${ROS_DISTRO}-xgc2-vrpn-relay)" >&2
  exit 1
fi

SERVER="${VRPN_SERVER:-127.0.0.1}"
PORT="${VRPN_PORT:-3883}"
TRACKER="${MOCAP_RIGID_BODY:?Set this aircraft MOCAP_RIGID_BODY in /etc/xgc2/fs150/onboard.env}"
VISION="${VISION_OUT:-/mavros/vision_pose/pose}"
HZ="${VISION_TARGET_HZ:-30.0}"

echo "xgc2 fs150 mocap: ${TRACKER}@${SERVER}:${PORT} vision=${VISION}"
exec roslaunch "${LAUNCH}" \
  server:="${SERVER}" \
  port:="${PORT}" \
  tracker:="${TRACKER}" \
  vision_out:="${VISION}" \
  vision_target_hz:="${HZ}"
