#!/usr/bin/env bash
set -euo pipefail

# Browser WebRTC for the onboard camera. The camera is a pipeline source of
# Media Edge: it opens the V4L2 device and runs the encoder only while a
# viewer, a capture or a recording needs it, so no camera service runs beside it.
EDGE="${XGC_MEDIA_EDGE:-$(command -v xgc-media-edge || true)}"
if [[ -z "${EDGE}" || ! -x "${EDGE}" ]]; then
  echo "xgc-media-edge not installed (apt xgc2-media-edge)" >&2
  exit 1
fi
ROSTER="${MEDIA_SOURCES:-/opt/xgc2/robots/fs150/onboard/sensors/src/fs150_onboard_sensors/config/media-sources.json}"
if [[ ! -f "${ROSTER}" ]]; then
  echo "missing media roster: ${ROSTER}" >&2
  exit 1
fi
PUBLIC_IP="${MEDIA_PUBLIC_IP:-}"
if [[ -z "${PUBLIC_IP}" ]]; then
  PUBLIC_IP="$(ip -4 -o addr show wlan0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1 || true)"
fi

# The unit grants RUNTIME as a private directory (RuntimeDirectory=). Media
# Edge needs its control socket, MediaMTX and pipeline directories inside it.
RUNTIME="${MEDIA_RUNTIME:-/run/xgc2/media-edge}"
/usr/lib/xgc2-media-edge/prepare-runtime \
  --runtime-root "${RUNTIME}" --uid "$(id -u)" --gid "$(id -g)" >/dev/null

ARGS=(
  --control-address "${MEDIA_CONTROL_ADDRESS:-0.0.0.0:18090}"
  --target-id "${XGC2_TARGET_ID:-$(hostname)}"
  --rpc-socket "${RUNTIME}/control/control.sock"
  --mediamtx-runtime-dir "${RUNTIME}/mediamtx"
  --pipeline-runtime-dir "${RUNTIME}/pipelines"
  --sources-config "${ROSTER}"
)
if [[ -n "${PUBLIC_IP}" ]]; then
  ARGS+=(--public-ip "${PUBLIC_IP}")
fi
exec "${EDGE}" "${ARGS[@]}"
