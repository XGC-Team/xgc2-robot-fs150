<launch>
  <!-- Assembly only. The VRPN client and the vrpn_relay node (C++) live in xgc2_vrpn_relay. -->
  <arg name="server" default="127.0.0.1" />
  <arg name="port" default="3883" />
  <arg name="tracker" default="FS150_01" />
  <arg name="vision_out" default="/mavros/vision_pose/pose" />
  <arg name="vision_target_hz" default="30.0" />

  <include file="$(find xgc2_vrpn_relay)/launch/mocap.launch">
    <arg name="server" value="$(arg server)" />
    <arg name="port" value="$(arg port)" />
    <arg name="tracker" value="$(arg tracker)" />
    <arg name="vision_out" value="$(arg vision_out)" />
    <arg name="vision_target_hz" value="$(arg vision_target_hz)" />
    <!-- The relay can take over a track that jumped and stays where it is (default 1 s). Off on
         the aircraft: a jump stays rejected, as before that option existed. Turning it on is an
         FS150 owner decision, because PX4 EKF2 would see a step in the vision position when the
         track is taken over. -->
    <arg name="jump_reacquire_s" value="0.0" />
  </include>
</launch>
