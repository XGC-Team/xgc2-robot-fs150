#!/bin/sh
set -e

systemd_running() {
  [ -d /run/systemd/system ]
}

write_retract_pin() {
  mkdir -p /etc/apt/preferences.d
  # apt ignores preferences.d names with extra dots (not .pref).
  rm -f /etc/apt/preferences.d/xgc2-fs150-retract-0.1.0-20
  cat > /etc/apt/preferences.d/xgc2-fs150-retract-20 <<'EOF'
Package: xgc2-fs150-mavlink-router
Pin: version 0.1.0-20
Pin-Priority: -1

Package: xgc2-fs150
Pin: version 0.1.0-20
Pin-Priority: -1
EOF
}

if [ "$1" = "configure" ] && command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload >/dev/null 2>&1 || true
  write_retract_pin

  # The camera is a pipeline source of Media Edge now; the camera unit of
  # earlier packages owned the device and an RTP port of its own.
  for old_service in startMavRoute.service fs150-mavlink-router.service mavlink-router.service xgc2-fs150-camera.service; do
    if systemd_running; then
      systemctl stop "${old_service}" >/dev/null 2>&1 || true
    fi
    systemctl disable "${old_service}" >/dev/null 2>&1 || true
  done

  # Install units only. Never enable communication, MAVROS, mocap, or
  # Media Edge. 0.1.0-20 shipped a rates helper that Wants from the
  # router and started it on upgrade; retract that leftover.
  if systemd_running; then
    systemctl stop xgc2-fs150-mavlink-rates.service >/dev/null 2>&1 || true
  fi
  systemctl disable xgc2-fs150-mavlink-rates.service >/dev/null 2>&1 || true
  systemctl mask xgc2-fs150-mavlink-rates.service >/dev/null 2>&1 || true
  systemctl disable xgc2-fs150-mavros.service >/dev/null 2>&1 || true
  systemctl disable xgc2-fs150-mocap.service >/dev/null 2>&1 || true
  systemctl disable xgc2-fs150-media-edge.service >/dev/null 2>&1 || true
fi

exit 0
